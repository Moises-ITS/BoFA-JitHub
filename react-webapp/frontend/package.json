{
  "name": "react-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": "20.x || 22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n frontend,backend -c blue,yellow \"vite\" \"npm run dev --prefix ../backend\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "videos:optimize": "node scripts/optimize-videos.mjs",
    "videos:optimize:apply": "node scripts/optimize-videos.mjs --apply"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/topojson-client": "^3.1.5",
    "@vercel/analytics": "^2.0.1",
    "3d-force-graph": "^1.80.0",
    "cesium": "^1.139.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "resium": "^1.19.4",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "supabase": "^2.77.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "scriptsSupabase": {
    "supabase:init": "supabase init",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  }
}
