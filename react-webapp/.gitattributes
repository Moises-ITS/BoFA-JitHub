# Normalize line endings for all text files
* text=auto

# Force LF for source files (prevents CRLF on Windows checkouts)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mjs  text eol=lf
*.sql  text eol=lf

# Jiti's club corpus (backend/rag/data/text_files/njit_orgs.csv). Pinned to LF
# so a Windows checkout, a Linux CI runner, and Railway all read byte-identical
# bytes: jitiCorpusService builds the cached prompt prefix from this file, and
# the cost model in jitiQuotaService assumes that prefix never drifts.
*.csv  text eol=lf

# Binary files — no line-ending normalization
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.webm binary


