DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
PG_SSL_REJECT_UNAUTHORIZED=true
ENFORCE_PRIVATE_DATABASE=true

NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-password
NEO4J_DATABASE=neo4j

FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
ENFORCE_HTTPS=false

REDIS_CONNECTION_STRING=redis://default:PASSWORD@HOST:6379
# Required, backend-only. The FRONTEND uses VITE_CLERK_PUBLISHABLE_KEY (pk_...)
# in frontend/.env.local — a different key, not a substitute for this one.
CLERK_SECRET_KEY=sk_test_replace_me

# Optional. A PEM public key (Clerk Dashboard > API Keys > "JWT Public Key")
# lets utils/clerkToken.ts verify session tokens locally instead of calling
# Clerk on each request. Omit it and auth still works, just with a round trip.
# PEM only — a pk_/sk_ value pasted here is rejected silently.
# CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# HMAC-SHA256 key that signs guest/professor session tokens (src/utils/customToken.ts).
# Clerk-authenticated students do NOT use this — it is unrelated to any CLERK_* value.
# Generate your own; never reuse this placeholder or share it across environments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical across all backend instances, or tokens minted by one replica
# fail verification on another. Changing it signs every guest/professor out once.
# Unset, customToken.ts falls back to a hardcoded string committed to this repo,
# which lets anyone holding the source mint a valid session for any user id.
JWT_SECRET=replace-with-32-random-bytes-base64

# Jiti v2 — the Claude Haiku 4.5 NJIT-clubs chatbot (src/services/jitiService.ts).
# Flagged off by default; requires Redis (see REDIS_CONNECTION_STRING above)
# for its per-user/global daily quotas, which are enforced regardless of this key.
ANTHROPIC_API_KEY=example
ANTHROPIC_MODEL=claude-haiku-4-5
JITI_ENABLED=false
JITI_DAILY_USER_LIMIT=5
JITI_GLOBAL_DAILY_CENTS=65
JITI_MAX_OUTPUT_TOKENS=300
JITI_RESERVE_CENTS=3
