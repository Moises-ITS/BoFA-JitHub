# Copy this file to .env and fill in your values
# (this example file is safe to commit — .env is gitignored)

PORT=3001
FRONTEND_URL=http://localhost:5173

# Neo4j AuraDB — get from teammate or Neo4j console
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# PostgreSQL (Railway) — get from Railway dashboard
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
DB_HOST=<host>
DB_PORT=5432
DB_USER=<user>
DB_PASSWORD=<password>
DB_NAME=<database>

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<your-random-32-char-secret>
